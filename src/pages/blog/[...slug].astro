---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatDate,
  formatEntryDate,
  getPostDate,
  getPostSlug,
  getVisiblePosts,
  isPrivateEntry,
  type BlogEntry,
} from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);
const rawDate = getPostDate(post);
const publishedLabel = formatEntryDate(post);
const publishedIso = rawDate ? formatDate(rawDate) : undefined;
const updatedStr = post.data.updatedAt ? formatDate(post.data.updatedAt) : null;
const isPriv = isPrivateEntry(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary || post.data.title}
  ogType="article"
>
  <article class="post reveal" style="--i: 0">
    {
      isPriv && (
        <aside class="preview-banner" role="status">
          <span class="status-pill status-pill--private">Private</span>
          <span>
            비공개(<code>status: private</code>) 글입니다. 로컬 개발 서버에서만 보이며 프로덕션 빌드·RSS·사이트맵에는 포함되지 않습니다.
          </span>
        </aside>
      )
    }

    <header class="post__header">
      <div class="post__meta mono tnum">
        <time datetime={publishedIso}>{publishedLabel}</time>
        {updatedStr && updatedStr !== publishedIso && <span>· 수정 {updatedStr}</span>}
      </div>
      <h1 class="post__title">{post.data.title}</h1>
      {post.data.summary && <p class="post__summary">{post.data.summary}</p>}
      {
        post.data.tags.length > 0 && (
          <ul class="post__tags" aria-label="태그">
            {post.data.tags.map((tag) => (
              <li class="post__tag mono">#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose post__body">
      <Content />
    </div>

    <footer class="post__footer">
      <a class="control" href="/blog/">← 글 목록으로</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-xl);
  }

  .preview-banner {
    margin-block-end: var(--space-lg);
    padding: var(--space-sm) var(--space-md);
    border: var(--rule-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-paper-2);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
  }

  .post__header {
    padding-block-end: var(--space-xl);
    border-block-end: var(--rule-hairline);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .post__meta {
    font-size: var(--text-sm);
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .post__title {
    font-size: var(--text-2xl);
    line-height: 1.18;
  }

  .post__summary {
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: 1.55;
  }

  .post__tags {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .post__tag {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .post__body {
    padding-block: var(--space-xl);
  }

  .post__footer {
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-hairline);
  }
</style>
